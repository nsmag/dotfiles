[user]
	name = Natthakit Susanthitanon
	email = natthakit.susanthitanon@gmail.com
[core]
	pager = delta
[delta]
	navigate = true
	side-by-side = true
	syntax-theme = base16
  line-numbers-minus-style = "#eb6f92"
  line-numbers-plus-style = "#31748f"
  line-numbers-zero-style = "#6e6a86"
  minus-style = syntax "#2d222d"
  minus-emph-style = syntax "#45283c"
  plus-style = syntax "#1e2a30"
  plus-emph-style = syntax "#253f44"
[diff]
	colorMoved = default
[interactive]
	diffFilter = delta --color-only
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
[pull]
	ff = only
[alias]
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(magenta)%an%C(reset)%C(bold yellow)%d%C(reset)' --all
[include]
  path = ~/.gitconfig.local
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
